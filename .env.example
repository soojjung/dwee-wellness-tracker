# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Absolute site URL used to resolve OG/Twitter image URLs.
# Defaults to http://localhost:3000 when unset. Set the production origin
# (e.g. https://dwee.app) on staging/production so social crawlers can fetch
# /og-image.png with an absolute URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
