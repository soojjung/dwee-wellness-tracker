# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Absolute site URL used to resolve OG/Twitter image URLs.
# Defaults to http://localhost:3000 when unset. Set the production origin
# (e.g. https://dwee.app) on staging/production so social crawlers can fetch
# /og-image.png with an absolute URL. Read only in the root layout (server
# component at build time) — no NEXT_PUBLIC_ prefix needed.
SITE_URL=http://localhost:3000

# Crash reporting (Sentry, release STEP 1.7). The DSN is a public key and is
# baked into the client bundle; leave it empty to disable reporting entirely.
# Production builds report; dev sends nothing unless NEXT_PUBLIC_SENTRY_DEBUG=1.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DEBUG=1

# Source-map upload for `pnpm sentry:sourcemaps` (build-time only, never
# shipped). Create at sentry.io → Settings → Auth Tokens with scopes
# project:releases + org:read. SENTRY_ORG / SENTRY_PROJECT default to sooya / dwee.
SENTRY_AUTH_TOKEN=
