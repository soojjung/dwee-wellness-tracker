{
  "name": "dwee",
  "version": "1.0.0",
  "iosBuild": 4,
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "pnpm build:release && cap sync && pnpm ios:setup",
    "cap:ios": "pnpm build:release && cap sync ios && pnpm ios:setup && cap open ios",
    "ios:setup": "node scripts/setup-ios.mjs",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs",
    "build:release": "next build && pnpm sentry:sourcemaps",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "dependencies": {
    "@capacitor/action-sheet": "^6",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/keyboard": "^6",
    "@capacitor/local-notifications": "^6",
    "@capacitor/share": "^6",
    "@capacitor/status-bar": "^6",
    "@sentry/capacitor": "4.3.0",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@playwright/test": "^1.60.0",
    "@sentry/cli": "^3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.12.0"
}
